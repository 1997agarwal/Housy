# Required in production: any long random string (e.g. `openssl rand -hex 32`). Signs login cookies.
HOUSY_SESSION_SECRET=

# SMS login (MSG91). If unset, production refuses to send codes unless HOUSY_DEV_OTP=1.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Demo mode: show the OTP on screen instead of sending an SMS. Automatic in `npm run dev`;
# in production set to 1 ONLY for public demos — anyone can then log in as any phone number.
HOUSY_DEV_OTP=

# Comma-separated phone numbers allowed to open /admin (ops dashboard). Empty = nobody.
HOUSY_ADMIN_PHONES=
